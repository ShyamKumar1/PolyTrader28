# =============================================================================
# PolyTrader28 - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: NEVER commit .env to Git! It contains secrets.

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 1. POLYGON WALLET (Required for live trading)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Your Polygon wallet private key (starts with 0x...)
# The V2 SDK uses this to sign orders (EIP-712) and derive API credentials.
#
# How to get your private key:
#   MetaMask: Settings → Security & Privacy → Export Private Key
#   Polymarket email account: Settings → Private Key → Export
#
# WARNING: This key has access to your funds. Keep it secret!
WALLET_PRIVATE_KEY=""
# Your Polygon wallet address (starts with 0x...)
WALLET_ADDRESS=""

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 2. POLYMARKET API CREDENTIALS (Auto-derived by V2 SDK)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# The V2 SDK automatically derives these from your private key on first run.
# You do NOT need to manually generate them from polymarket.com/profile/api.
# On first live run, the SDK will print the derived credentials to the log.
# Save them if you want, but they're cached internally by the SDK.
POLYMARKET_API_KEY=""
POLYMARKET_SECRET=""
POLYMARKET_PASSPHRASE=""

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 3. INITIAL CAPITAL (USDC/pUSD on Polygon network)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Starting capital in USDC. Default: 6.0 (≈ ₹500)
# The bot will auto-detect your actual balance on-chain.
# Note: Polymarket now uses pUSD (Polymarket USD) as collateral.
# When you deposit USDC on Polygon, it's auto-converted to pUSD.
INITIAL_CAPITAL_USDC=6.0

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 4. BINANCE API (Read-only keys for price feed)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Generate from https://www.binance.com/en/support/faq/how-to-create-api-keys
# Only need Market Data permissions (read-only).
BINANCE_API_KEY=""
BINANCE_API_SECRET=""

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 5. TRADING CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Trading mode: "live" or "dry_run"
#   live    - Real trades on Polymarket mainnet (requires WALLET_PRIVATE_KEY)
#   dry_run - Simulated orders, no real money moved (default)
TRADING_MODE="dry_run"

# Maximum position size as % of bankroll (default: 5%)
MAX_POSITION_PCT=5.0

# Maximum concurrent open positions
MAX_CONCURRENT_POSITIONS=3

# Stop-loss per trade (-15% hardcoded minimum, this can be stricter)
STOP_LOSS_PCT=-15.0

# Daily drawdown limit before halting (percent)
DAILY_DRAWDOWN_LIMIT=15.0

# Minimum edge threshold for Strategy A (percent)
# Bot enters only when edge exceeds this value. Range: 3.0 - 5.0
MIN_EDGE_THRESHOLD=3.0

# Strategy B execution threshold (YES + NO price sum)
# Enter when sum <= this value. Default: 0.985
COMPLETE_SET_THRESHOLD=0.985

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 6. TELEGRAM ALERTS (Optional)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Get bot token from @BotFather on Telegram
# Get chat ID by messaging @userinfobot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 7. DASHBOARD SECURITY (Optional - for remote access)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# If exposing dashboard to internet, set a password for /api/stop and /api/start
DASHBOARD_API_KEY=""
